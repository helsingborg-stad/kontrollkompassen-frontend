{
	# ingress-nginx terminates TLS before requests reach this container.
	auto_https off
	admin off

	# Do not size PHP workers from the Kubernetes node's CPU count. This app has a
	# small pod allocation, so retain a small, fixed classic-mode pool.
	frankenphp {
		num_threads 2
		max_threads 2

		# Keep diagnostic details in the container log, never in HTTP responses.
		php_ini display_errors Off
		php_ini display_startup_errors Off
		php_ini html_errors Off
		php_ini log_errors On
		php_ini error_log /proc/self/fd/1
		php_ini error_reporting E_ALL
	}
}

:8080 {
	root * /app/app
	encode zstd gzip

	# php_server serves existing files and falls back to the front controller.
	# This replaces app/.htaccess, which Caddy does not read.
	php_server
}
